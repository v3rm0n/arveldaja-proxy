# e-Financials API Credentials
# Get these from https://www.rik.ee/e-arveldaja/api-support

# Your API Key ID (used in the signed payload)
API_KEY_ID=your_api_key_id

# Your API Key Public value (used in the X-AUTH-KEY header)
API_KEY_PUBLIC=your_api_key_public

# Your API Key Password (used for HMAC-SHA-384 signing)
API_KEY_PASSWORD=your_api_key_password

# API Base URL (demo or production)
API_BASE_URL=https://demo-rmp-api.rik.ee/v1

# Server Port
PORT=3000

# Path to the SQLite database shared by the proxy server and the MCP server.
# Defaults to pending_changes.db in the project root (resolved relative to the
# code, not the working directory, so both processes find the same file).
# DB_PATH=/absolute/path/to/pending_changes.db

# Comma-separated list of browser origins allowed to call the API (CORS).
# Defaults to http://localhost:<PORT>. Do NOT use a wildcard: it would let any
# website the user visits issue cross-origin write/approval requests.
# ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated list of Host headers accepted on the /mcp endpoint (DNS
# rebinding protection). Defaults to localhost and 127.0.0.1, with and without
# the port. Only set this if MCP clients reach the server under another host.
# MCP_ALLOWED_HOSTS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# Optional shared secret. When set, all write operations (proxy writes,
# approvals, rejections, deletes) require this token via an
# `Authorization: Bearer <token>` or `X-Proxy-Token` header. The bundled review
# UI picks it up from `?token=<token>` in the URL (stored in localStorage).
# MCP-over-HTTP messages are all POSTs, so MCP clients must send the token too.
# Leave unset to disable the guard (reads are always open).
# PROXY_AUTH_TOKEN=change-me
